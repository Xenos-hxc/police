SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://127.0.0.1:3306/railway_security_check_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=railway_app
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_COOKIE_SECURE=true
