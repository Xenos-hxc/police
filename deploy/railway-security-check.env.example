UPLOAD_TEMP_PATH=/opt/railway-security-check/uploads/.multipart
LOG_PATH=/opt/railway-security-check/logs
FILE_ANTIVIRUS_ENABLED=true
FILE_ASYNC_SCAN_ENABLED=true
FILE_SCAN_INTERVAL_MS=5000
FILE_OBJECT_STORE_ENABLED=false
