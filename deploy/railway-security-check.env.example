S3_ACCESS_KEY=CHANGE_ME_IF_ENABLED
S3_SECRET_KEY=CHANGE_ME_IF_ENABLED
S3_BUCKET=railway-attachments
FILE_QUEUE_ENABLED=false
RABBITMQ_HOST=127.0.0.1
